media/
*.mp4
*.zip
*.part

# Certificados locales del diseño inicial (incluyen una clave privada)
server/certs/
# Certificado del puerto directo de DASH y cuenta de Let's Encrypt (clave privada)
certs/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Node (el detalle está en web/.gitignore)
node_modules/
dist/

# Configuración local del despliegue; las variables posibles, en .env.template (que sí se sube)
.env
# Datos de los despliegues propios para Claude Code (CLAUDE.md, «Servidores desplegados»)
CLAUDE.local.md
# Historia del desarrollo con fechas y copias de la documentación anterior: solo en local
local/
