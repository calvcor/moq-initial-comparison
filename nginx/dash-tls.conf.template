# Puerto 443 de nginx-dash (8443 en el router), con el certificado de SERVER_HOST. entrypoint.sh lo rellena y lo deja
# dentro del server de dash.conf, que pone la ruta: la misma que la del 80.
listen 443 ssl;
ssl_certificate     __CERT__;
ssl_certificate_key __KEY__;
ssl_protocols       TLSv1.2 TLSv1.3;
