# .env para un despliegue SIN la capa TLS: en local, o en un servidor con un proxy HTTPS delante (p. ej. Nginx
# Proxy Manager) que reenvía al puerto 80.
# Para un servidor sin proxy, con su propio certificado, usa .env.tls.template.
#
# Uso: cp .env.template .env, rellenar y `docker compose up -d --build`.
# En local no hace falta .env: todo funciona con los valores por defecto en http://localhost.

# =================================================================================================================
# 1. Servidor con proxy HTTPS delante (docs/deployment.md)
# =================================================================================================================

# Nombre con el que se abre la página (el del proxy).
PUBLIC_HOST=testbed.ejemplo.org

# IP del servidor, si el nombre de la página apunta al proxy. Por ella van MoQ y WebRTC, que no pasan por el proxy.
MOQ_HOST=10.0.0.5

# Nombre DNS que apunta directamente al servidor (no al proxy). Con él, DASH va por HTTPS al puerto 8443 sin pasar
# por el proxy. Sin él, DASH solo funciona desde páginas HTTP.
DASH_HOST=directo.ejemplo.org

# Token de DuckDNS para obtener el certificado de DASH_HOST. Secreto.
DUCKDNS_TOKEN=

# =================================================================================================================
# 2. Opcional. Descomentar solo lo que haga falta; el valor que aparece es el que se usa por defecto.
# =================================================================================================================

# --- Puertos del servidor ---
# HTTP_PORT=80            # página y API (lo que reenvía el proxy)
# MOQ_PORT=4433           # MoQ, UDP
# DASH_PORT=8443          # DASH con TLS (con DASH_HOST)
# DASH_HTTP_PORT=8080     # DASH sin TLS (sin DASH_HOST)

# --- Cámara RTSP en lugar del vídeo en bucle (docs/architecture.md) ---
# CAMERA_RTSP_URL=rtsp://usuario:clave@192.168.1.20:554/stream1
# CAMERA_FPS=15           # solo si la cámara no anuncia bien su cadencia

# --- WebRTC (docs/architecture.md) ---
# RTC_SERVER=mediasoup    # mediasoup (con adaptación) o mediamtx (una calidad, sin adaptación)
# RTC_INGEST=udp          # solo con mediamtx: udp o rtsp
# SFU_TRACE=1             # registro de diagnóstico del SFU

# --- Versiones de terceros. Cambian lo que se mide: declararlo con los resultados. Requieren --build ---
# MOQ_RELAY_FROM=release  # relay: release (MOQ_RELAY_VERSION) o git (MOQ_RELAY_COMMIT)
# MOQ_RELAY_VERSION=0.17.9
# MOQ_RELAY_COMMIT=c19c723d90c6e8df60c9a656cc2a4d92ee358295
# MOQ_CLI_FROM=release    # publicador: release (MOQ_CLI_VERSION) o git (MOQ_CLI_COMMIT; varios GB de RAM)
# MOQ_CLI_VERSION=0.14.7
# MOQ_CLI_COMMIT=bc64b9c52561209322dcb8dec9992bf867f499f7
# MOQ_WATCH_FROM=release  # reproductor @moq/watch: release (npm) o git (MOQ_WATCH_COMMIT)
# MOQ_WATCH_COMMIT=bc64b9c52561209322dcb8dec9992bf867f499f7
# MOQ_WATCH_PATCHES=1     # con git: 1 aplica web/patches/ (hechos para bc64b9c), 0 sin parches
# MOQ_WATCH_BUN=1.3.5     # con git: 1.4.4 para commits desde c19c723
# MEDIAMTX_VERSION=1.21.3
