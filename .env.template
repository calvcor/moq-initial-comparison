# .env de un servidor (docs/deployment.md). En local no hace falta: sin .env todo funciona en http://localhost.
#
# Uso: cp .env.template .env, rellenar y `docker compose up -d --build`. La página queda en https://<SERVER_HOST>.
# La primera vez, MoQ y la página por HTTPS esperan al certificado (un par de minutos).

# Nombre DNS que resuelve a la IP de este servidor desde la red de los navegadores. Por él van la página, DASH, MoQ y
# la señalización de WebRTC, con un mismo certificado de Let's Encrypt.
SERVER_HOST=testbed.ejemplo.org

# API DNS de acme.sh con la que se obtiene el certificado (reto DNS: no hace falta abrir ningún puerto a Internet), y su
# token con el nombre de variable que espera acme.sh. Lista: https://github.com/acmesh-official/acme.sh/wiki/dnsapi
ACME_DNS=dns_duckdns
DuckDNS_Token=
# ACME_DNS=dns_cf
# CF_Token=               # Cloudflare: permisos Zone DNS Edit y Zone Read

# =================================================================================================================
# Opcional. Descomentar solo lo que haga falta; el valor que aparece es el que se usa por defecto.
# =================================================================================================================

# --- Dirección para WebRTC ---
# SERVER_IP=10.0.0.5      # IP anunciada en los candidatos ICE; por defecto, la que resuelve SERVER_HOST

# --- Cámara RTSP en lugar del vídeo en bucle (docs/architecture.md) ---
# CAMERA_RTSP_URL=rtsp://usuario:clave@192.168.1.20:554/stream1
# CAMERA_FPS=15           # solo si la cámara no anuncia bien su cadencia

# --- WebRTC (docs/architecture.md) ---
# RTC_SERVER=mediasoup    # mediasoup (con adaptación) o mediamtx (una calidad, sin adaptación)
# RTC_PACING_FACTOR=2.5   # ritmo del pacer de la ingesta (rtc_pacing) respecto al bitrate de cada calidad
# SFU_TRACE=1             # registro de diagnóstico del SFU

# --- Versiones de terceros. Por defecto se instala la última publicada al construir (requieren --build) ---
# Descomentar solo para fijar una versión concreta o compilar MoQ desde un commit.
# MOQ_RELAY_FROM=release  # relay: release (MOQ_RELAY_VERSION) o git (MOQ_RELAY_COMMIT)
# MOQ_RELAY_VERSION=latest
# MOQ_RELAY_COMMIT=c19c723d90c6e8df60c9a656cc2a4d92ee358295
# MOQ_CLI_FROM=release    # publicador: release (MOQ_CLI_VERSION) o git (MOQ_CLI_COMMIT; varios GB de RAM)
# MOQ_CLI_VERSION=latest
# MOQ_CLI_COMMIT=bc64b9c52561209322dcb8dec9992bf867f499f7
# MOQ_WATCH_FROM=release  # reproductor @moq/watch: release (MOQ_WATCH_VERSION) o git (MOQ_WATCH_COMMIT)
# MOQ_WATCH_VERSION=latest
# MOQ_WATCH_COMMIT=bc64b9c52561209322dcb8dec9992bf867f499f7
# MOQ_WATCH_PATCHES=1     # con git: 1 aplica web/patches/ (hechos para bc64b9c), 0 sin parches
# MOQ_WATCH_BUN=1.3.5     # con git: 1.4.4 para commits desde c19c723
# DASHJS_VERSION=latest
# MEDIASOUP_VERSION=latest
# MEDIASOUP_CLIENT_VERSION=latest
# MEDIAMTX_VERSION=latest
